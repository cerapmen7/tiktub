{
  "name": "tiktub",
  "version": "1.0.0",
  "description": "TikTub - AI-powered TikTok to YouTube automation with multi-channel & multi-agent architecture",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "workspaces": [
    "backend",
    "frontend",
    "agents/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:electron": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\" \"wait-on http://localhost:3001/api/health && wait-on http://localhost:5173 && electron .\"",
    "electron": "electron .",
    "electron:build": "tsc --project electron/tsconfig.json && node -e \"const fs=require('fs'); fs.copyFileSync('electron/src/splash.html','dist-electron/splash.html'); try{fs.renameSync('dist-electron/main.js','dist-electron/main.cjs')}catch(e){}; try{fs.renameSync('dist-electron/preload.js','dist-electron/preload.cjs')}catch(e){}; try{fs.renameSync('dist-electron/main.js.map','dist-electron/main.cjs.map')}catch(e){}; try{fs.renameSync('dist-electron/preload.js.map','dist-electron/preload.cjs.map')}catch(e){}; let c=fs.readFileSync('dist-electron/main.cjs','utf8'); c=c.replace(/preload\\.js/g,'preload.cjs'); fs.writeFileSync('dist-electron/main.cjs',c);\"",

    "build": "npm run build --workspaces && npm run electron:build",
    "build:all": "npm run build --workspace=backend && npm run build --workspace=frontend && npm run electron:build",
    "start": "npm run start --workspace=backend",
    "dist": "npm run build:all && electron-builder",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:portable": "npm run build:all && electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps",
    "install:all": "npm install",
    "lint": "eslint .",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "tiktok",
    "youtube",
    "automation",
    "ai",
    "scraper",
    "repost"
  ],
  "author": "cerapmen7",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.2",
    "googleapis": "^130.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
