{
  "name": "@tiktub/scheduler-agent",
  "version": "1.0.0",
  "description": "Agent Scheduler pour TikTub — queue en mémoire, gestion délais, cron, persistance JSON (sans Redis/BullMQ)",
  "type": "module",
  "main": "dist/agents/scheduler-agent/src/index.js",
  "types": "dist/agents/scheduler-agent/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["scheduler", "queue", "cron", "tiktub", "node-cron"]
}
